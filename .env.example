# Used by Streamlit (streamlit_app/config.py) — same names as the former Vite app
#
# If VITE_SUPABASE_URL is empty, the app uses direct Elsevier SciVal API only (typical for Railway).
# Set VITE_SUPABASE_URL (+ anon key) only if you use the Supabase scival-proxy function.

# Supabase (optional — only if using the proxy instead of direct API)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# SciVal API (direct API + ORCID lookup) — any one of:
# VITE_SCIVAL_API_KEY=...
# SCIVAL_API_KEY=...
# ELSEVIER_API_KEY=...
# ELS_API_KEY=...
VITE_SCIVAL_API_KEY=your_scival_api_key

# Optional: institutional token for SciVal (required by some institutions; matches Elsevier query param insttoken)
# ELSEVIER_INSTTOKEN=

# Optional: force direct Elsevier API (true) or proxy (false) when VITE_SUPABASE_URL is set.
# If unset and Supabase URL is set, proxy mode is used.
# VITE_USE_DIRECT_API=true