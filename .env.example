# Used by Streamlit (streamlit_app/config.py) — same names as the former Vite app
# Supabase (required when VITE_USE_DIRECT_API is false)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# SciVal API (direct API + ORCID lookup)
VITE_SCIVAL_API_KEY=your_scival_api_key

# Optional: institutional token for SciVal (required by some institutions; matches Elsevier query param insttoken)
# ELSEVIER_INSTTOKEN=

# true = call Elsevier directly; false = use Supabase edge function scival-proxy
VITE_USE_DIRECT_API=true